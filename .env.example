# Copy this file to .env (.env is never committed). It is loaded by application.properties.

# Shared rentamovil database with the fleet_app user (rtm-fleet-maintenance-db, 03_dcl), never sa.
# DATABASE_PASSWORD = parameter.fleetAppPassword in rtm-fleet-maintenance-db/liquibase.properties
DATABASE_URL=jdbc:sqlserver://localhost:1433;databaseName=rentamovil;encrypt=true;trustServerCertificate=true
DATABASE_USERNAME=fleet_app
DATABASE_PASSWORD=ChangeMe_FleetApp123!

APP_FLEET_MAINTENANCE_PORT=3002
