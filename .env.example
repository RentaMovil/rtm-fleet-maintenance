# Copy this file to .env (.env is never committed). It is loaded by application.properties.

# Shared rentamovil database with the fleet_app user (rtm-fleet-maintenance-db, 03_dcl), never sa.
# DATABASE_PASSWORD = parameter.fleetAppPassword in rtm-fleet-maintenance-db/liquibase.properties
DATABASE_URL=jdbc:sqlserver://localhost:1433;databaseName=rentamovil;encrypt=true;trustServerCertificate=true
DATABASE_USERNAME=fleet_app
DATABASE_PASSWORD=ChangeMe_FleetApp123!

APP_FLEET_MAINTENANCE_PORT=3002

# iam's PUBLIC RS256 key, base64 PEM text on one line. It's the SAME value as
# APP_IAM_JWT_PUBLIC_KEY in rtm-iam's .env, not a new one.
APP_FLEET_MAINTENANCE_JWT_PUBLIC_KEY=

# booking-reservation (vehicle occupancy)
BOOKING_URL=http://localhost:3003
BOOKING_TIMEOUT=3s
RETIRE_RESERVATION_HORIZON_DAYS=730

# Shared key to call/validate /internal/** between microservices (X-Internal-Key header).
# SAME key across booking-reservation, fleet-maintenance, payment-billing and telemetry-gps.
APP_INTERNAL_API_KEY=ChangeMe_InternalKey123!
